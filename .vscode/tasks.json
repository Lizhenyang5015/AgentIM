{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentIM: Configure macOS Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "macos-debug"],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "AgentIM: Build macOS Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "macos-debug"],
      "problemMatcher": "$gcc",
      "group": "build",
      "dependsOn": "AgentIM: Configure macOS Debug"
    },
    {
      "label": "AgentIM: Configure Windows Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "windows-debug"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "AgentIM: Build Windows Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-debug"],
      "problemMatcher": "$msCompile",
      "dependsOn": "AgentIM: Configure Windows Debug"
    }
  ]
}
